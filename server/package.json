{
  "name": "rooms-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/check-database.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:backup:verify": "tsx scripts/verify-backup.ts",
    "check:deployment": "tsx scripts/check-deployment.ts",
    "smoke:partner-catalog": "tsx scripts/smoke-partner-catalog.ts",
    "smoke:reviews": "tsx scripts/smoke-reviews.ts",
    "smoke:support": "tsx scripts/smoke-support.ts",
    "smoke:finance": "tsx scripts/smoke-finance.ts",
    "smoke:payments": "tsx scripts/smoke-payments.ts",
    "smoke:auth-security": "tsx scripts/smoke-auth-security.ts",
    "smoke:rate-limits": "tsx scripts/smoke-rate-limits.ts",
    "grant:benchmark": "tsx scripts/grant-benchmark.ts",
    "grant:pilot-import": "tsx scripts/grant-pilot-import.ts",
    "grant:pilot-benchmark": "tsx scripts/grant-pilot-benchmark.ts",
    "grant:oracle-check": "tsx scripts/grant-oracle-check.ts",
    "openapi:validate": "tsx scripts/validate-openapi.ts",
    "notifications:run-once": "tsx scripts/notification-worker.ts",
    "receipts:run-once": "tsx scripts/receipt-worker.ts",
    "refunds:run-once": "tsx scripts/refund-worker.ts",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "nodemailer": "^9.1.0",
    "otpauth": "^9.5.1",
    "pg": "^8.23.0",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "yaml": "^2.8.3"
  }
}
