# Template only: fill secrets in a private deployment environment, never in Git.
# The paid launch remains blocked until the production fiscal-receipt adapter exists.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
PUBLIC_SITE_URL=
# HTTPS origin, no trailing slash; same origin as the site is recommended.
PUBLIC_API_URL=
CORS_ORIGINS=
DATABASE_URL=
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=10
AUTH_TOKEN_SECRET=
RATE_LIMIT_HASH_KEY=
TWO_FACTOR_ENCRYPTION_KEY=
NOTIFICATION_ENCRYPTION_KEY=
FINANCE_ENCRYPTION_KEY=
TWO_FACTOR_REQUIRED=true
AUTH_COOKIE_SECURE=true
EXPOSE_PASSWORD_RESET_TOKEN=false
ALLOW_DEMO_SEED=false
ENABLE_DEMO_PAYMENTS=false
PHOTO_STORAGE_MODE=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# Both keys may be omitted when an infrastructure role supplies S3 credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_MEDIA_PREFIX=rooms/media
NOTIFICATION_DELIVERY_MODE=live
NOTIFICATION_WORKER_ENABLED=true
SMTP_URL=
EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
PAYMENT_PROVIDER=sber
SBER_API_BASE_URL=
SBER_USERNAME=
SBER_PASSWORD=
REFUND_WORKER_ENABLED=true
FISCAL_RECEIPT_MODE=disabled
FISCAL_RECEIPT_WORKER_ENABLED=false
BACKUP_DIR=server-data/backups
BACKUP_RETENTION_DAYS=14
